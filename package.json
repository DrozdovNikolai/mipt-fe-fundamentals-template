{
  "name": "gigachat-ui-shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:analyze": "tsc --noEmit && vite-bundle-visualizer --config vite.config.ts --output docs/bundle-report.html --open false --mode production",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.4"
  }
}
